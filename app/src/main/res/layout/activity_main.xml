<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="طباعة 10 نسخ بطاقة على A4"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <ImageView
        android:id="@+id/imgFront"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="#EEEEEE"
        android:contentDescription="أمامي"/>

    <Button
        android:id="@+id/btnFront"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الصورة الأمامية (كاميرا / استوديو)"
        android:layout_marginTop="8dp"/>

    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="200dp"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="#EEEEEE"
        android:layout_marginTop="16dp"
        android:contentDescription="خلفي"/>

    <Button
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="الصورة الخلفية (كاميرا / استوديو)"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/btnPrint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="طباعة 10 نسخ على A4"
        android:layout_marginTop="24dp"
        android:backgroundTint="#4CAF50"/>
</LinearLayout>
